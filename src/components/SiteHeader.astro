---
import { nav } from "../data/site";
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap inner">
    <a class="wordmark" href="/" aria-label="amri.dev, home">amri<span>.dev</span></a>
    <nav aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme" title="Toggle theme">
      <svg class="moon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <svg class="sun" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></g></svg>
    </button>
  </div>
</header>
