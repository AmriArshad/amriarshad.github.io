---
import { site, buttons } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap inner">
    <div>
      <div class="buttons">
        {buttons.map((b) => (
          <a href={b.href} title={b.title} target="_blank" rel="noopener">
            <img src={b.src} alt={b.title} width="88" height="31" loading="lazy" />
          </a>
        ))}
      </div>
      <p>© {year} Amri Arshad · Built with Astro, coloured with Catppuccin.</p>
    </div>
    <nav aria-label="Elsewhere">
      <a href={site.github}>GitHub</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={`mailto:${site.email}`}>Email</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>
